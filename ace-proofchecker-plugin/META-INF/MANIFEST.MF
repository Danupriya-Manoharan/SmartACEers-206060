Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: ACE Proofchecker Plugin
Bundle-SymbolicName: com.smartaceers.proofchecker;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: com.smartaceers.proofchecker.Activator
Bundle-Vendor: SmartACEers Team
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.jface,
 org.eclipse.ui.ide,
 org.eclipse.ui.workbench
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: com.smartaceers.proofchecker
Bundle-ActivationPolicy: lazy
Export-Package: com.smartaceers.proofchecker.core,
 com.smartaceers.proofchecker.handlers,
 com.smartaceers.proofchecker.parser,
 com.smartaceers.proofchecker.results,
 com.smartaceers.proofchecker.validators
